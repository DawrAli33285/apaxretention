# ─── Database (optional) ─────────────────────────────────────────────────────
# Leave blank to use the built-in database that ships with the app
# (data/apax.db, created from database/apax-starter.db).
# Set to a Postgres connection string for a permanent hosted database.
# On Vercel, connecting Neon under Storage sets this for you.
DATABASE_URL=
# Where the built-in database file lives (default: data/apax.db)
SQLITE_PATH=

# ─── Optional ───────────────────────────────────────────────────────────────
# Session signing key. If blank, a strong key is generated once and stored in the database.
JWT_SECRET=
# Creates an administrator if the database has none (not needed with the starter database).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# If set, that one-time form also asks for this key (recommended for public deployments).
SETUP_TOKEN=

# ─── Social listening providers (leave blank to run in DEMO mode) ────────────
PDL_API_KEY=
RAPIDAPI_KEY=
# auto = live when both keys are set, otherwise demo. Force with live | demo.
PROVIDER_MODE=auto
PDL_MIN_LIKELIHOOD=6
SOCIAL_LOOKBACK_DAYS=60
SOCIAL_MAX_PAGES=3

# ─── Commute distance ───────────────────────────────────────────────────────
# census = free US Census geocoder. none = only use a "Distance (Miles)" column.
GEOCODER=census
# Default job site if a client has none set in Admin > Clients & users
JOB_SITE_LABEL=
JOB_SITE_LAT=
JOB_SITE_LON=

# ─── Pricing and rules ──────────────────────────────────────────────────────
PRICE_PER_RECORD_CURRENT=2.95
PRICE_PER_RECORD_PREHIRE=0
NEW_USER_CREDITS=0
ENFORCE_MONTHLY_LIMIT=true
ALLOW_SELF_REGISTER=false
# Age is a protected characteristic. Leave false unless counsel approves (see README).
ENABLE_AGE_FACTOR=false
DATA_RETENTION_DAYS=90
MAX_RECORDS_PER_JOB=5000
MAX_ROWS_PER_FILE=20000

# ─── Optional email (notifications, invoices, password reset) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
# Public address of the app, e.g. https://retention.example.com (needed for password-reset links)
APP_URL=

# ─── Optional branding (frontend, read at build time) ───────────────────────
VITE_BRAND_NAME=The Apax Group
VITE_BRAND_TAGLINE=Understand People. Optimize Outcomes.
VITE_PRODUCT_NAME=Workforce Intelligence
VITE_BRAND_LOGO_URL=
VITE_SUPPORT_EMAIL=

# ─── Demo presentation ──────────────────────────────────────────────────────
# Off by default: prices, credits and the Invoices page are hidden from client
# screens, and the demo-mode / short-password / temporary-database notices are
# not shown at the top of the page. Set to true to show them.
SHOW_PRICING=false
SHOW_NOTICES=false
